# OS
.DS_Store

# Downloaded binaries (APKs and similar) — don't version large/binary artifacts
downloads/
*.apk
*.tmp
*.log

# Telemetry captures contain a Wi-Fi SSID, private IPs, and (in baseline_*.txt) a
# MAC-derived IPv6 address. Do NOT commit raw captures.
# A redacted sample is kept as committed evidence: logs/SAMPLE_telemetry_redacted.jsonl
logs/*.jsonl
logs/*.csv
logs/*.txt
!logs/SAMPLE_*.jsonl

# Python bytecode / envs / tool caches
__pycache__/
*.pyc
.venv/
venv/
env/
.env
*.env
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Third-party clone (source-inspection only, not ours to version)
external/

# Cache-monitor server access: never commit a credential pointer or a private key path
# that has been filled in. The .example.json (disabled, placeholder values) IS committed.
cache_monitor/config/server_inspection.json
cache_monitor_reports/

# Site monitor reports — public-site data, but keep raw runs out of git.
reports/site_monitor*/
site_monitor/reports/*
!site_monitor/reports/.gitkeep
report_latest.*
report_2*.json
report_2*.md
report_2*.html
# Raw generated crawl dumps under evidence dirs (keep only hand-authored *SUMMARY*.md).
reports/full_coverage_crawl_*/report_full_coverage.*

# Measurement API credentials — never in the repo (see measurement_queue/api/creds.py)
.ambimat_measure_creds/
**/google_service_account.json
**/anthropic_api_key
**/bing_api_key
**/linkedin_oauth.json
*.pem

# Phone recovery evidence: the hand-authored analysis and manifests ARE committed;
# the raw device archives (~14 MB of runtime crawl output) stay on disk only.
reports/phone_recovery_*/raw/
